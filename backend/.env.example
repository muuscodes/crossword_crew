# Copy this file to backend/.env and replace the placeholder values.
# Never commit backend/.env.

PORT=3000
NODE_ENV=development

# Long random string used to sign session cookies. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace_with_a_long_random_string

# Database used by the backend. With `docker compose up`, the app container overrides
# DB_HOST and DB_PORT to reach the db service. These values are for running the backend
# on your machine against that same database (`npm run dev`).
DB_HOST=localhost
DB_PORT=5433
DB_USER=crossword
DB_PASSWORD=replace_with_a_database_password
DB_NAME=crossword_crew

# Read by the Postgres container to create the database. Keep them equal to the DB_* values.
POSTGRES_USER=crossword
POSTGRES_PASSWORD=replace_with_a_database_password
POSTGRES_DB=crossword_crew

# Optional: Google sign-in. Leave blank to turn it off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URI=http://localhost:3000/auth/google/redirect

# Optional: Gmail account used to send welcome, sharing and feedback emails.
# EMAIL_APP_PASS is a Gmail app password, not your normal password.
EMAIL_USER=
EMAIL_APP_PASS=

# Optional: where messages from the Feedback page (bugs, ideas and comments) go.
# Defaults to crossword.crew.team@gmail.com.
FEEDBACK_EMAIL=

# Optional: puzzle copied into every new account (default 1). Use "none" to turn it off.
WELCOME_GRID_ID=1

# Optional: number of reverse proxies in front of the app. Defaults to 1 when
# NODE_ENV=production and off otherwise. Set it to false if nothing sits in front of the app.
TRUST_PROXY=
